
---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout
  title="Heritage Lens | Training Minds for Caring Hands"
  description="An educational and research platform for cultural heritage, conservation, museology and art history."
>
  <Container>
    <main>
      <!-- HERO -->
      <section class="hero">
        <p class="eyebrow">AN EDUCATIONAL & RESEARCH PLATFORM</p>
        <h1>Heritage Lens.</h1>
        <p class="tagline">Training Minds for Caring Hands.</p>
        <p class="intro">
          Explore. Learn. Understand.
        </p>
      </section>

      <!-- INTRODUCTION -->
      <section class="introduction">
        <div class="intro-label">A SPACE FOR LEARNING</div>
        <div class="intro-content">
          <h2>
            Understanding heritage begins with understanding
            why it matters.
          </h2>
          <p>
            Heritage Lens is a learning and research platform dedicated
            to the study of cultural heritage. It brings together
            conservation, museology and art history through accessible
            learning resources, research-based knowledge and critical
            perspectives.
          </p>
          <p>
            Whether you are a student, researcher, museum professional
            or simply curious about heritage, this is a space to explore
            ideas, develop understanding and learn through inquiry.
          </p>
        </div>
      </section>

      <!-- EXPLORE -->
      <section class="explore" id="explore">
        <div class="section-heading">
          <span>01 / EXPLORE</span>
          <span>AREAS OF STUDY</span>
        </div>

        <div class="explore-grid">
          <a href="#conservation" class="explore-item">
            <span class="item-number">01</span>
            <span class="item-name">Conservation</span>
            <span class="item-arrow">↗</span>
          </a>

          <a href="#museology" class="explore-item">
            <span class="item-number">02</span>
            <span class="item-name">Museology</span>
            <span class="item-arrow">↗</span>
          </a>

          <a href="#art-history" class="explore-item">
            <span class="item-number">03</span>
            <span class="item-name">Art History</span>
            <span class="item-arrow">↗</span>
          </a>
        </div>
      </section>

      <!-- AREAS OF STUDY -->
      <section class="study-areas">
        <div class="section-heading">
          <span>02 / LEARNING AREAS</span>
          <span>KNOWLEDGE & PRACTICE</span>
        </div>

        <article class="study-card" id="conservation">
          <span class="study-number">01</span>
          <div>
            <h2>Conservation</h2>
            <p>
              Explore the principles, ethics, materials and practices
              involved in the preservation of cultural heritage.
              Understand deterioration, documentation, treatment
              approaches and preventive conservation.
            </p>
            <span class="study-note">Learning resources coming soon</span>
          </div>
        </article>

        <article class="study-card" id="museology">
          <span class="study-number">02</span>
          <div>
            <h2>Museology</h2>
            <p>
              Discover the changing role of museums in society.
              Explore collections management, documentation,
              interpretation, exhibition practices, education
              and the responsibilities of museum professionals.
            </p>
            <span class="study-note">Learning resources coming soon</span>
          </div>
        </article>

        <article class="study-card" id="art-history">
          <span class="study-number">03</span>
          <div>
            <h2>Art History</h2>
            <p>
              Study artworks, artistic traditions, visual cultures
              and historical contexts. Develop an understanding
              of how art reflects societies, ideas, materials
              and cultural exchange.
            </p>
            <span class="study-note">Learning resources coming soon</span>
          </div>
        </article>
      </section>

      <!-- LEARNING APPROACH -->
      <section class="learning">
        <div class="section-heading">
          <span>03 / OUR APPROACH</span>
        </div>

        <h2>Learning beyond information.</h2>
        <p>
          We believe meaningful learning comes from observation,
          questioning, critical thinking and the ability to connect
          knowledge with practice.
        </p>
        <p>
          The platform will bring together learning materials,
          research references, study resources and interactive
          learning experiences to encourage independent thinking
          and continued exploration.
        </p>
      </section>

      <!-- FOOTER -->
      <footer>
        <div class="footer-brand">
          <span>HERITAGE LENS</span>
          <span>Training Minds for Caring Hands.</span>
        </div>

        <div class="footer-credit">
          <span>AN INITIATIVE BY</span>
          <strong>Yoombi Conservation Consultancy</strong>
        </div>
      </footer>
    </main>
  </Container>
</BaseLayout>

<style>
  .hero {
    padding: 7rem 0 5rem;
  }

  .eyebrow,
  .intro-label,
  .section-heading,
  .study-number,
  .study-note {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #858585;
  }

  .hero h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    margin: 1.5rem 0 0.75rem;
  }

  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: #333;
  }

  .intro {
    margin-top: 1.5rem;
    color: #888;
    font-size: 0.9rem;
  }

  .introduction {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 4rem 0;
    border-top: 1px solid #e8e8e8;
  }

  .intro-content {
    max-width: 680px;
  }

  .intro-content h2,
  .learning h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  .intro-content p,
  .learning p,
  .study-card p {
    font-size: 0.95rem;
    line-height: 1.9;
    color: #737373;
    margin-bottom: 1rem;
  }

  .explore,
  .study-areas,
  .learning {
    margin: 5rem 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }

  .explore-grid {
    display: flex;
    flex-direction: column;
  }

  .explore-item {
    display: grid;
    grid-template-columns: 60px 1fr 30px;
    align-items: center;
    padding: 1.6rem 0;
    border-bottom: 1px solid #eee;
    text-decoration: none;
    color: #292929;
  }

  .item-number {
    font-size: 0.75rem;
    color: #999;
  }

  .item-name {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
  }

  .item-arrow {
    text-align: right;
    color: #7a8f6a;
  }

  .explore-item:hover .item-name {
    color: #7a8f6a;
  }

  .study-card {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid #eee;
    scroll-margin-top: 5rem;
  }

  .study-number {
    padding-top: 0.6rem;
  }

  .study-card h2 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.8rem;
  }

  .study-card p {
    max-width: 650px;
  }

  .study-note {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.65rem;
  }

  .learning {
    max-width: 700px;
    padding: 2rem 0;
  }

  .learning h2 {
    margin-top: 2rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    border-top: 1px solid #eee;
    padding: 2.5rem 0;
    margin-top: 5rem;
    color: #888;
    font-size: 0.75rem;
  }

  .footer-brand,
  .footer-credit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-brand span:first-child {
    color: #555;
    letter-spacing: 0.06em;
  }

  .footer-credit {
    text-align: right;
  }

  .footer-credit span {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .footer-credit strong {
    color: #555;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 4rem;
    }

    .introduction {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .study-card {
      grid-template-columns: 35px 1fr;
    }

    footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-credit {
      text-align: left;
    }
  }
</style>
