
---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout
  title="Heritage Lens | Training Minds for Caring Hands"
  description="An educational and research platform for cultural heritage."
>
  <Container>
    <section class="hero">
      <h1>Heritage Lens.</h1>
      <p class="tagline">Training Minds for Caring Hands.</p>
      <p class="intro">Explore. Learn. Understand.</p>
    </section>

    <section class="visual">
      <div class="image-placeholder">
        <span>Heritage Lens</span>
      </div>
    </section>

    <section class="about" id="about">
      <div class="section-heading">
        <span>01 / ABOUT</span>
        <a href="#about">Discover ↗</a>
      </div>
    </section>

    <section class="explore" id="explore">
      <div class="section-heading">
        <span>02 / EXPLORE</span>
      </div>

      <div class="explore-grid">
        <a href="#conservation" class="explore-item">
          <span>Conservation</span>
          <span>↗</span>
        </a>

        <a href="#museology" class="explore-item">
          <span>Museology</span>
          <span>↗</span>
        </a>

        <a href="#art-history" class="explore-item">
          <span>Art History</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <footer>
      <div class="footer-brand">
        <span>HERITAGE LENS</span>
        <span>Training Minds for Caring Hands.</span>
      </div>

      <div class="footer-credit">
        <span>AN INITIATIVE BY</span>
        <strong>Yoombi Conservation Consultancy</strong>
      </div>
    </footer>
  </Container>
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0 3rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: 1.25rem;
    color: #333333;
    margin-bottom: 0.5rem;
  }

  .intro {
    font-size: 0.9rem;
    color: #888888;
  }

  .visual {
    margin: 2rem 0 5rem;
  }

  .image-placeholder {
    min-height: 320px;
    background: #f5f5f2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999999;
    font-size: 0.85rem;
  }

  .about,
  .explore {
    margin: 5rem 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #777777;
  }

  .section-heading a {
    color: #777777;
  }

  .explore-grid {
    display: flex;
    flex-direction: column;
  }

  .explore-item {
    display: flex;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-bottom: 1px solid #eeeeee;
    color: #242424;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .explore-item:hover {
    color: #647b69;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    border-top: 1px solid #eeeeee;
    padding: 2.5rem 0;
    margin-top: 5rem;
    color: #888888;
    font-size: 0.75rem;
  }

  .footer-brand,
  .footer-credit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-brand span:first-child {
    color: #555555;
    letter-spacing: 0.06em;
  }

  .footer-credit {
    text-align: right;
  }

  .footer-credit span {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .footer-credit strong {
    color: #555555;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 4rem;
    }

    .image-placeholder {
      min-height: 220px;
    }

    footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-credit {
      text-align: left;
    }
  }
</style>
