
---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

import heroImage from "../assets/pexels-mikegles-30489757.jpg";
import conservationImage from "../assets/pexels-almir-reis-1982745319-29044862.jpg";
import museologyImage from "../assets/pexels-livi-soul-59228898-10232784.jpg";
import artHistoryImage from "../assets/pexels-tarak-b-1084821-29396993.jpg";
import learningImage from "../assets/pexels-kosyginl-34293083.jpg";
---

<BaseLayout
  title="Waakhal Studies | Shaping Minds for Caring Hands"
  description="Waakhal Studies is an educational and research platform by Yoombi Conservation Consultancy, exploring art conservation, art history, museology and cultural heritage."
>
  <Container>
    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">AN EDUCATIONAL & RESEARCH PLATFORM</p>
          <h1>Waakhal Studies.</h1>
          <p class="tagline">Shaping Minds for Caring Hands.</p>
          <p class="intro">Explore. Learn. Understand.</p>
        </div>

        <figure class="hero-image">
          <img
            src={heroImage.src}
            alt="A museum visitor viewing a painting in an art gallery"
            fetchpriority="high"
          />

          <figcaption>
            Photograph by
            <a
              href="https://www.pexels.com/@mikegles/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Miguel González
            </a>
            ·
            <a
              href="https://www.pexels.com/photo/art-enthusiast-observing-classic-painting-in-gallery-30489757/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Pexels
            </a>
          </figcaption>
        </figure>
      </section>

      <!-- INTRODUCTION -->
      <section class="introduction">
        <div class="intro-label">A SPACE FOR LEARNING</div>

        <div class="intro-content">
          <h2>
            Understanding heritage begins with understanding
            why it matters.
          </h2>

          <p>
            Waakhal Studies is an educational and research platform
            developed by Yoombi Conservation Consultancy,
            dedicated to the study of cultural heritage. It brings
            together art conservation, museology, art history and
            related fields through accessible learning resources,
            research-based knowledge and critical perspectives.
          </p>

          <p>
            Whether you are a student, researcher, museum professional
            or simply curious about heritage, this is a space to explore
            ideas, develop understanding and learn through inquiry.
          </p>
        </div>
      </section>

      <!-- EXPLORE -->
      <section class="explore" id="explore">
        <div class="section-heading">
          <span>01 / EXPLORE</span>
          <span>AREAS OF STUDY</span>
        </div>

        <div class="explore-grid">

          <a href="/conservation/" class="explore-item">
            <span class="item-number">01</span>
            <span class="item-name">Conservation</span>
            <span class="item-arrow">↗</span>
          </a>

          <a href="/museology/" class="explore-item">
            <span class="item-number">02</span>
            <span class="item-name">Museology</span>
            <span class="item-arrow">↗</span>
          </a>

          <a href="/art-history/" class="explore-item">
            <span class="item-number">03</span>
            <span class="item-name">Art History</span>
            <span class="item-arrow">↗</span>
          </a>

        </div>
      </section>

      <!-- AREAS OF STUDY -->
      <section class="study-areas">
        <div class="section-heading">
          <span>02 / LEARNING AREAS</span>
          <span>KNOWLEDGE & PRACTICE</span>
        </div>

        <!-- CONSERVATION -->
        <article
          class="study-card study-card-with-image"
          id="conservation"
        >
          <span class="study-number">01</span>

          <div class="study-content">
            <h2>
              <a href="/conservation/">
                Conservation
              </a>
            </h2>

            <p>
              Explore the principles, ethics, materials and practices
              involved in the preservation of cultural heritage.
              Understand deterioration, documentation, treatment
              approaches and preventive conservation.
            </p>

            <span class="study-note">
              Learning resources coming soon
            </span>
          </div>

          <figure class="study-image">
            <img
              src={conservationImage.src}
              alt="An artist working on a painting"
              loading="lazy"
            />

            <figcaption>
              Photograph by
              <a
                href="https://www.pexels.com/@almir-reis-1982745319/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Almir Reis
              </a>
              ·
              <a
                href="https://www.pexels.com/photo/art-restorer-working-on-a-masterpiece-in-paris-29044862/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Pexels
              </a>
            </figcaption>
          </figure>
        </article>

        <!-- MUSEOLOGY -->
        <article
          class="study-card study-card-with-image"
          id="museology"
        >
          <span class="study-number">02</span>

          <div class="study-content">
            <h2>
              <a href="/museology/">
                Museology
              </a>
            </h2>

            <p>
              Discover the changing role of museums in society.
              Explore collections management, documentation,
              interpretation, exhibition practices, education
              and the responsibilities of museum professionals.
            </p>

            <span class="study-note">
              Learning resources coming soon
            </span>
          </div>

          <figure class="study-image">
            <img
              src={museologyImage.src}
              alt="A colourful traditional sculpted figure displayed in an architectural setting"
              loading="lazy"
            />

            <figcaption>
              Photograph by
              <a
                href="https://www.pexels.com/@livi-soul-59228898/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Livi Soul
              </a>
              ·
              <a
                href="https://www.pexels.com/photo/statue-of-god-10232784/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Pexels
              </a>
            </figcaption>
          </figure>
        </article>

        <!-- ART HISTORY -->
        <article
          class="study-card study-card-with-image"
          id="art-history"
        >
          <span class="study-number">03</span>

          <div class="study-content">
            <h2>
              <a href="/art-history/">
                Art History
              </a>
            </h2>

            <p>
              Study artworks, artistic traditions, visual cultures
              and historical contexts. Develop an understanding
              of how art reflects societies, ideas, materials
              and cultural exchange.
            </p>

            <span class="study-note">
              Learning resources coming soon
            </span>
          </div>

          <figure class="study-image">
            <img
              src={artHistoryImage.src}
              alt="A woman studying the intricate stone carvings of an ancient temple"
              loading="lazy"
            />

            <figcaption>
              Photograph by
              <a
                href="https://www.pexels.com/@tarak-b-1084821/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Tarak B
              </a>
              ·
              <a
                href="https://www.pexels.com/photo/ancient-temple-exploration-by-a-woman-29396993/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Pexels
              </a>
            </figcaption>
          </figure>
        </article>

      </section>

      <!-- LEARNING APPROACH -->
      <section class="learning">
        <div class="section-heading">
          <span>03 / OUR APPROACH</span>
        </div>

        <div class="learning-grid">
          <div class="learning-content">
            <h2>Learning beyond information.</h2>

            <p>
              We believe meaningful learning comes from observation,
              questioning, critical thinking and the ability to connect
              knowledge with practice.
            </p>

            <p>
              The platform will bring together learning materials,
              research references, study resources and interactive
              learning experiences to encourage independent thinking
              and continued exploration.
            </p>
          </div>

          <figure class="learning-image">
            <img
              src={learningImage.src}
              alt="Performers presenting a traditional dance in ornate costumes"
              loading="lazy"
            />

            <figcaption>
              Photograph by
              <a
                href="https://www.pexels.com/@kosyginl/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Kosygin Leishangthem
              </a>
              ·
              <a
                href="https://www.pexels.com/photo/34293083/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Pexels
              </a>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- FOOTER -->
      <footer>
        <div class="footer-brand">
          <span>WAAKHAL STUDIES</span>
          <span>Shaping Minds for Caring Hands.</span>
        </div>

        <div class="footer-credit">
          <span>AN INITIATIVE BY</span>
          <strong>Yoombi Conservation Consultancy</strong>
        </div>
      </footer>

    </main>
  </Container>
</BaseLayout>

<style>
  /* HERO */

  .hero {
    padding: 4rem 0 3rem;
  }

  .hero-content {
    margin-bottom: 2rem;
  }

  .eyebrow,
  .intro-label,
  .section-heading,
  .study-number,
  .study-note {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #858585;
  }

  .hero h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    margin: 1.5rem 0 0.75rem;
  }

  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: #333;
  }

  .intro {
    margin-top: 1.5rem;
    color: #888;
    font-size: 0.9rem;
  }

  /* IMAGES AND CREDITS */

  .hero-image {
    margin: 0;
  }

  .hero-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    object-position: center 48%;
  }

  figure figcaption {
    margin-top: 0.6rem;
    color: #999;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }

  figure figcaption a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #d0d0d0;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  figure figcaption a:hover {
    color: #7a8f6a;
  }

  /* INTRODUCTION */

  .introduction {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 4rem 0;
    border-top: 1px solid #e8e8e8;
  }

  .intro-content {
    max-width: 680px;
  }

  .intro-content h2,
  .learning h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  .intro-content p,
  .learning p,
  .study-card p {
    font-size: 0.95rem;
    line-height: 1.9;
    color: #737373;
    margin-bottom: 1rem;
  }

  /* SECTION SPACING */

  .explore,
  .study-areas,
  .learning {
    margin: 5rem 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }

  /* EXPLORE */

  .explore-grid {
    display: flex;
    flex-direction: column;
  }

  .explore-item {
    display: grid;
    grid-template-columns: 60px 1fr 30px;
    align-items: center;
    padding: 1.6rem 0;
    border-bottom: 1px solid #eee;
    text-decoration: none;
    color: #292929;
  }

  .item-number {
    font-size: 0.75rem;
    color: #999;
  }

  .item-name {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
  }

  .item-arrow {
    text-align: right;
    color: #7a8f6a;
  }

  .explore-item:hover .item-name {
    color: #7a8f6a;
  }

  /* STUDY AREAS */

  .study-card {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid #eee;
    scroll-margin-top: 5rem;
  }

  .study-number {
    padding-top: 0.6rem;
  }

  .study-card h2 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.8rem;
  }

  /* STUDY AREA LINKS */

  .study-content h2 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .study-content h2 a:hover {
    color: #7a8f6a;
  }

  .study-card p {
    max-width: 650px;
  }

  .study-card-with-image {
    grid-template-columns: 60px minmax(0, 1fr) minmax(220px, 0.75fr);
    align-items: start;
  }

  .study-image {
    margin: 0;
  }

  .study-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
  }

  .study-note {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.65rem;
  }

  /* LEARNING APPROACH */

  .learning {
    padding: 2rem 0;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 4rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  .learning-content {
    max-width: 600px;
  }

  .learning h2 {
    margin-top: 0;
  }

  .learning-image {
    margin: 0;
  }

  .learning-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
  }

  .learning-image figcaption {
    margin-top: 0.6rem;
    color: #999;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
  }

  .learning-image figcaption a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #d0d0d0;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .learning-image figcaption a:hover {
    color: #7a8f6a;
  }

  /* FOOTER */

  footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    border-top: 1px solid #eee;
    padding: 2.5rem 0;
    margin-top: 5rem;
    color: #888;
    font-size: 0.75rem;
  }

  .footer-brand,
  .footer-credit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-brand span:first-child {
    color: #555;
    letter-spacing: 0.06em;
  }

  .footer-credit {
    text-align: right;
  }

  .footer-credit span {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .footer-credit strong {
    color: #555;
    font-weight: 500;
  }

  /* TABLET */

  @media (max-width: 768px) {
    .learning-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .learning-image {
      max-width: 480px;
    }

    .study-card-with-image {
      grid-template-columns: 35px 1fr;
    }

    .study-image {
      grid-column: 2;
      max-width: 420px;
      margin-top: 1rem;
    }
  }

  /* MOBILE */

  @media (max-width: 640px) {
    .hero {
      padding-top: 4rem;
    }

    .hero-image img {
      aspect-ratio: 4 / 3;
    }

    .introduction {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .study-card {
      grid-template-columns: 35px 1fr;
    }

    footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-credit {
      text-align: left;
    }
  }
</style>
