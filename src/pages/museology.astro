
---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const topics = [
  {
    number: "01",
    title: "Introduction to Museology",
    description: "Understanding museums, their history, purpose, functions and changing roles in society."
  },
  {
    number: "02",
    title: "History and Development of Museums",
    description: "The evolution of museums, collecting traditions and the emergence of modern museum institutions."
  },
  {
    number: "03",
    title: "Museums and Society",
    description: "Museums as cultural institutions, public spaces and places of dialogue, identity and memory."
  },
  {
    number: "04",
    title: "Collections and Collection Management",
    description: "Collection policies, acquisition, accessioning, deaccessioning and responsible stewardship."
  },
  {
    number: "05",
    title: "Documentation and Information Management",
    description: "Cataloguing, inventories, object records, digital documentation and collection information systems."
  },
  {
    number: "06",
    title: "Exhibition Development",
    description: "Exhibition planning, design, object selection, interpretation and display environments."
  },
  {
    number: "07",
    title: "Museum Education and Interpretation",
    description: "Learning strategies, visitor engagement, accessibility and communicating cultural heritage."
  },
  {
    number: "08",
    title: "Museum Administration and Management",
    description: "Institutional structures, policies, governance, planning, finance and professional responsibilities."
  },
  {
    number: "09",
    title: "Preventive Care and Risk Management",
    description: "Collection care, environmental monitoring, security, emergency planning and risk assessment."
  },
  {
    number: "10",
    title: "Contemporary Issues and Case Studies",
    description: "Current debates, changing museum practices and examples from institutions and communities."
  },
  {
    number: "11",
    title: "References and Further Reading",
    description: "Books, research papers, professional guidelines and useful learning resources."
  }
];
---

<BaseLayout
  title="Museology | Heritage Lens"
  description="Explore museology, museum history, collections, documentation, exhibitions, education and management."
>
  <Container>
    <div class="museology-page">

      <section class="page-hero">
        <p class="eyebrow">EXPLORE / MUSEOLOGY</p>
        <h1>Museology.</h1>
        <p class="lead">
          Exploring museums as institutions of knowledge,
          cultural memory, learning and public engagement.
        </p>
      </section>

      <section class="introduction">
        <div class="section-label">ABOUT THE DISCIPLINE</div>
        <div class="intro-content">
          <h2>Museums are more than collections of objects.</h2>
          <p>
            Museology examines the theory, history and practice
            of museums. It considers how museums collect, preserve,
            research, interpret and communicate cultural and
            natural heritage.
          </p>
          <p>
            From collection management and documentation to
            exhibitions, education and institutional responsibilities,
            museology explores the many ways museums connect
            objects, knowledge and people.
          </p>
        </div>
      </section>

      <section class="topics-section">
        <div class="section-heading">
          <span>01 / LEARNING MODULES</span>
          <span>EXPLORE THE SUBJECT</span>
        </div>

        <div class="topics-list">
          {topics.map((topic) => (
            <article class="topic">
              <span class="topic-number">{topic.number}</span>
              <div class="topic-content">
                <h3>
                  {topic.number === "01" ? (
                    <a href="/museology/introduction/">{topic.title}</a>
                  ) : (
                    topic.title
                  )}
                </h3>
                <p>{topic.description}</p>
              </div>
              <span class="topic-status">
                {topic.number === "01" ? "OPEN LESSON" : "COMING SOON"}
              </span>
            </article>
          ))}
        </div>
      </section>

      <section class="learning-note">
        <p class="eyebrow">LEARNING APPROACH</p>
        <h2>Collect. Preserve. Interpret. Connect.</h2>
        <p>
          Understanding museums means looking beyond their
          collections. It involves examining institutional
          responsibilities, professional practices, public
          engagement and the relationships between museums
          and the communities they serve.
        </p>
      </section>

      <nav class="page-navigation" aria-label="Learning area navigation">
        <a href="/explore/">← All learning areas</a>
        <a href="/art-history/">Next: Art History →</a>
      </nav>

    </div>
  </Container>
</BaseLayout>

<style>
  .museology-page {
    padding-top: 0.5rem;
  }

  .eyebrow,
  .section-label,
  .section-heading,
  .topic-number,
  .topic-status {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #858585;
  }

  .page-hero {
    max-width: 800px;
    padding: 3rem 0 3.5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 7vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    margin: 1.25rem 0;
  }

  .lead {
    max-width: 650px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #777;
  }

  .introduction {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 2.75rem 0;
    border-top: 1px solid #e8e8e8;
  }

  .intro-content {
    max-width: 700px;
  }

  .intro-content h2,
  .learning-note h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .intro-content p,
  .learning-note > p:last-child {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #737373;
    margin-bottom: 0.9rem;
  }

  .topics-section {
    margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .topic {
    display: grid;
    grid-template-columns: 45px 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid #eeeeee;
  }

  .topic-number {
    padding-top: 0.35rem;
  }

  .topic-content h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.4rem;
  }

  .topic-content h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .topic-content h3 a:hover {
    color: #647b69;
  }

  .topic-content p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #777;
    margin-bottom: 0;
  }

  .topic-status {
    font-size: 0.6rem;
    white-space: nowrap;
    padding-top: 0.4rem;
  }

  .learning-note {
    max-width: 700px;
    padding: 3rem 0;
    margin-top: 1rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .learning-note h2 {
    margin-top: 1rem;
  }

  .page-navigation {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0;
    font-size: 0.85rem;
  }

  .page-navigation a {
    color: #647b69;
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 2.5rem 0 2.75rem;
    }

    .introduction {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2.25rem 0;
    }

    .topic {
      grid-template-columns: 30px 1fr;
      gap: 0.75rem;
    }

    .topic-status {
      grid-column: 2;
    }

    .section-heading {
      font-size: 0.6rem;
    }

    .page-navigation {
      font-size: 0.75rem;
    }
  }
</style>
