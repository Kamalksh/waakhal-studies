
---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const topics = [
  {
    number: "01",
    title: "Introduction to Art History",
    description: "Understanding the study of art, its methods, scope and relationship with history and culture."
  },
  {
    number: "02",
    title: "Methods of Art Historical Study",
    description: "Visual analysis, stylistic analysis, iconography, attribution and interpretation."
  },
  {
    number: "03",
    title: "Art and Ancient Civilisations",
    description: "Artistic traditions, visual cultures and material expressions of early societies."
  },
  {
    number: "04",
    title: "Art History of India",
    description: "The development of Indian art across periods, regions, religious traditions and cultural contexts."
  },
  {
    number: "05",
    title: "Art of Asia and the World",
    description: "Exploring artistic traditions, exchanges and visual cultures across different geographical contexts."
  },
  {
    number: "06",
    title: "Art Movements and Styles",
    description: "Major artistic movements, stylistic developments and changing approaches to artistic expression."
  },
  {
    number: "07",
    title: "Materials, Techniques and Processes",
    description: "Understanding the materials, technologies and processes involved in the creation of artworks."
  },
  {
    number: "08",
    title: "Patronage and the Art Market",
    description: "The influence of patrons, institutions, collecting practices and markets on artistic production."
  },
  {
    number: "09",
    title: "Interpreting Art and Visual Culture",
    description: "Meaning, symbolism, representation, identity and the interpretation of visual objects."
  },
  {
    number: "10",
    title: "Modern and Contemporary Art",
    description: "Developments in modern and contemporary artistic practices, ideas and critical perspectives."
  },
  {
    number: "11",
    title: "Artists, Objects and Case Studies",
    description: "Focused studies of artists, artworks, collections and their historical contexts."
  },
  {
    number: "12",
    title: "References and Further Reading",
    description: "Books, catalogues, research papers and resources for further study."
  }
];
---

<BaseLayout
  title="Art History | Heritage Lens"
  description="Explore art history, artistic traditions, visual analysis, materials, movements and cultural contexts."
>
  <Container>
    <div class="art-history-page">

      <section class="page-hero">
        <p class="eyebrow">EXPLORE / ART HISTORY</p>
        <h1>Art History.</h1>
        <p class="lead">
          Exploring artistic traditions, visual cultures
          and the histories, ideas and contexts behind
          works of art.
        </p>
      </section>

      <section class="introduction">
        <div class="section-label">ABOUT THE DISCIPLINE</div>
        <div class="intro-content">
          <h2>Every artwork carries a history.</h2>
          <p>
            Art history examines the creation, meaning and
            interpretation of works of art across time and
            different cultural contexts. It explores how
            artistic expressions reflect the societies,
            beliefs, ideas and experiences from which they emerge.
          </p>
          <p>
            Through the study of artists, objects, materials,
            techniques and visual traditions, art history
            helps us understand not only what we see, but
            also the historical circumstances and cultural
            meanings that shape it.
          </p>
        </div>
      </section>

      <section class="topics-section">
        <div class="section-heading">
          <span>01 / LEARNING MODULES</span>
          <span>EXPLORE THE SUBJECT</span>
        </div>

        <div class="topics-list">
          {topics.map((topic) => (
            <article class="topic">
              <span class="topic-number">{topic.number}</span>
              <div class="topic-content">
                <h3>{topic.title}</h3>
                <p>{topic.description}</p>
              </div>
              <span class="topic-status">COMING SOON</span>
            </article>
          ))}
        </div>
      </section>

      <section class="learning-note">
        <p class="eyebrow">LEARNING APPROACH</p>
        <h2>Look closely. Ask questions. Discover context.</h2>
        <p>
          Studying art involves more than recognising artists,
          styles or historical periods. It requires close
          observation, visual analysis and an understanding
          of the historical, social and cultural contexts
          in which artworks were produced and interpreted.
        </p>
      </section>

      <nav class="page-navigation" aria-label="Learning area navigation">
        <a href="/explore/">← All learning areas</a>
        <a href="/conservation/">← Conservation</a>
      </nav>

    </div>
  </Container>
</BaseLayout>

<style>
  .art-history-page {
    padding-top: 0.5rem;
  }

  .eyebrow,
  .section-label,
  .section-heading,
  .topic-number,
  .topic-status {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #858585;
  }

  .page-hero {
    max-width: 800px;
    padding: 3rem 0 3.5rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 7vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    margin: 1.25rem 0;
  }

  .lead {
    max-width: 650px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #777;
  }

  .introduction {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 2.75rem 0;
    border-top: 1px solid #e8e8e8;
  }

  .intro-content {
    max-width: 700px;
  }

  .intro-content h2,
  .learning-note h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .intro-content p,
  .learning-note > p:last-child {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #737373;
    margin-bottom: 0.9rem;
  }

  .topics-section {
    margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .topic {
    display: grid;
    grid-template-columns: 45px 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid #eeeeee;
  }

  .topic-number {
    padding-top: 0.35rem;
  }

  .topic-content h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.4rem;
  }

  .topic-content p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #777;
    margin-bottom: 0;
  }

  .topic-status {
    font-size: 0.6rem;
    white-space: nowrap;
    padding-top: 0.4rem;
  }

  .learning-note {
    max-width: 700px;
    padding: 3rem 0;
    margin-top: 1rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .learning-note h2 {
    margin-top: 1rem;
  }

  .page-navigation {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0;
    font-size: 0.85rem;
  }

  .page-navigation a {
    color: #647b69;
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 2.5rem 0 2.75rem;
    }

    .introduction {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2.25rem 0;
    }

    .topic {
      grid-template-columns: 30px 1fr;
      gap: 0.75rem;
    }

    .topic-status {
      grid-column: 2;
    }

    .section-heading {
      font-size: 0.6rem;
    }

    .page-navigation {
      font-size: 0.75rem;
    }
  }
</style>
