    padding: 1.7rem;
    border: 1px solid #e8e8e8;
    margin: 1.5rem 0 2rem;
  }

  .reflection h3 {
    margin-top: 1rem;
    line-height: 1.5;
  }

  .reflection p:last-child {
    margin-bottom: 0;
  }

  .reference-item {
    padding: 1.3rem 0;
    border-bottom: 1px solid #eeeeee;
  }

  .reference-item h3 {
    margin-top: 0;
  }

  .reference-item p {
    margin-bottom: 0.5rem;
