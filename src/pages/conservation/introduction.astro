    max-width: 700px;
    color: #777;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2rem;
  }

  .lesson-layout {
    display: grid;
    grid-template-columns: 190px minmax(0, 700px);
    gap: 5rem;
    padding: 3rem 0;
    align-items: start;
  }

  .lesson-sidebar {
    position: sticky;
    top: 2rem;
  }

  .lesson-sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .lesson-sidebar a {
    color: #777;
    font-size: 0.82rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .lesson-sidebar a:hover,
  .reference-item a:hover {
    color: #647b69;
  }

  .lesson-content {
    min-width: 0;
  }

  .lesson-section {
    padding: 0 0 3.5rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid #e8e8e8;
    scroll-margin-top: 2rem;
  }

  .section-label {
    margin-bottom: 1.2rem;
  }

  .lesson-section h2 {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.3;
    margin-bottom: 1.4rem;
  }

  .lesson-section h3 {
    font-size: 1.15rem;
    font-weight: 500;
    margin: 1.8rem 0 0.7rem;
  }

  .lesson-section p,
  .lesson-section li {
    color: #707070;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .lesson-section ul,
  .lesson-section ol {
    padding-left: 1.3rem;
    margin: 1rem 0;
  }

  .lesson-section li {
    padding-left: 0.3rem;
    margin-bottom: 0.5rem;
  }

  .reference-note {
    background: #f7f8f6;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .reference-note .note-label {
    margin-bottom: 0.8rem;
  }

  .reference-note p {
    margin-bottom: 0.8rem;
  }

  .reference-note a,
  .reference-item a {
    color: #647b69;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .approach {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid #eeeeee;
  }

  .approach-number {
    color: #8a9b80;
    font-size: 0.8rem;
    padding-top: 0.4rem;
  }

  .approach h3 {
    margin-top: 0;
  }

  .approach p {
    margin-bottom: 0.8rem;
  }

  .approach .example {
    font-size: 0.88rem;
    color: #858585;
  }

  .scope-list {
    margin: 2rem 0;
  }

  .scope-list > div {
    padding: 1.2rem 0;
    border-bottom: 1px solid #eeeeee;
  }

  .scope-list h3 {
    margin: 0 0 0.4rem;
  }

  .scope-list p {
    margin: 0;
  }

