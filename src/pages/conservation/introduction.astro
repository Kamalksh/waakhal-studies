  .eyebrow,
  .section-label,
  .lesson-meta,
  .note-label,
  .scenario-label {
    color: #858585;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .lesson-hero {
    max-width: 850px;
    padding: 3rem 0 3.5rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .lesson-hero h1 {
    max-width: 800px;
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1.08;
    margin: 1.4rem 0;
  }

