---
const moduleId = "conservation-module-01";
---

<section
  id="knowledge-check"
  class="module-quiz"
  data-module-id={moduleId}
  aria-labelledby="quiz-title"
>
  <header class="quiz-heading">
    <p class="quiz-eyebrow">08 / TEST YOUR KNOWLEDGE</p>
    <h2 id="quiz-title">Check your understanding.</h2>
    <p class="quiz-intro">
      Ten questions to help you reflect on what you have learned.
      Read each question carefully and select one answer.
    </p>
  </header>

  <div class="quiz-progress-area">
    <div class="quiz-progress-heading">
      <span class="progress-label">YOUR PROGRESS</span>
      <span data-progress-text>0 of 10 answered</span>
    </div>

    <div
      class="progress-track"
      role="progressbar"
      aria-label="Quiz completion"
      aria-valuemin="0"
      aria-valuemax="10"
      aria-valuenow="0"
      data-progress-track
    >
      <div class="progress-fill" data-progress-bar></div>
    </div>
  </div>

  <form data-quiz-form>
    <div class="quiz-questions" data-questions></div>

    <div class="quiz-footer">
      <p>10 questions · 1 mark each · No negative marking</p>
      <button type="submit" class="quiz-submit" data-submit disabled>
        Submit answers
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </form>

  <div
    class="quiz-results"
    data-results
    hidden
    aria-live="polite"
  ></div>
</section>

<script>
  type QuizQuestion = {
    id: string;
    question: string;
    options: string[];
    answer: number;
    explanation: string;
    section: string;
    difficulty: "Basic" | "Intermediate" | "Application";
  };

  const QUESTION_BANK: QuizQuestion[] = [
    {
      id: "m01-q01",
      question: "What is the primary purpose of cultural heritage conservation?",
      options: [
        "To restore all damaged objects to their original appearance",
        "To safeguard cultural heritage for present and future generations",
        "To make heritage objects suitable for museum display",
        "To replace deteriorated materials with modern alternatives"
      ],
      answer: 1,
      explanation: "Conservation aims to safeguard cultural heritage while ensuring its accessibility to present and future generations.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q02",
      question: "Which of the following best explains why cultural heritage is significant?",
      options: [
        "It provides material evidence of human creativity, knowledge, belief and social experience.",
        "It primarily represents the economic value of historical objects.",
        "It allows museums to display rare and expensive collections.",
        "It provides examples of objects that can be restored."
      ],
      answer: 0,
      explanation: "Cultural heritage carries historical, artistic, scientific, spiritual, social and cultural significance.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q03",
      question: "Which activity is included within the broader practice of conservation?",
      options: [
        "Only repairing physically damaged objects",
        "Only maintaining the appearance of objects",
        "Preventive measures, examination, documentation, research and treatment",
        "Replacing old materials with new materials"
      ],
      answer: 2,
      explanation: "Conservation is broader than repair. It includes preventive measures, scientific examination, documentation, research, treatment and responsible management.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q04",
      question: "Which of the following is an example of preventive conservation?",
      options: [
        "Retouching losses in a painting",
        "Reassembling a broken sculpture",
        "Consolidating a fragile painted surface",
        "Improving storage and environmental management"
      ],
      answer: 3,
      explanation: "Preventive conservation aims to avoid or minimise future deterioration through measures addressing the environment and circumstances surrounding objects and collections.",
      section: "03 – Three approaches",
      difficulty: "Basic"
    },
    {
      id: "m01-q05",
      question: "What distinguishes remedial conservation from preventive conservation?",
      options: [
        "Remedial conservation involves direct action to arrest active deterioration or strengthen an object.",
        "Remedial conservation focuses exclusively on improving display conditions.",
        "Remedial conservation is concerned only with historical research.",
        "Remedial conservation involves changing the appearance of stable objects."
      ],
      answer: 0,
      explanation: "Remedial conservation involves direct action when an object's condition is fragile or deteriorating rapidly. Preventive conservation generally addresses the surrounding environment and circumstances.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q06",
      question: "Restoration, as described in the lesson, is generally undertaken on an object that is:",
      options: [
        "Actively deteriorating and structurally unstable",
        "Stable, but affected in its significance or function by past alteration or deterioration",
        "Completely free from any damage",
        "No longer considered culturally significant"
      ],
      answer: 1,
      explanation: "Restoration involves direct action on a stable object to facilitate its appreciation, understanding or use when past alteration or deterioration has affected its significance or function.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q07",
      question: "Which of the following correctly classifies the materials discussed in the lesson?",
      options: [
        "Paper and stone are both organic materials.",
        "Metals and textiles are both organic materials.",
        "Wood and leather are organic materials, while stone and ceramics are inorganic materials.",
        "Glass and photographs are both inorganic materials."
      ],
      answer: 2,
      explanation: "The lesson identifies paper, textiles, wood, leather and photographs as organic materials, and stone, metals, ceramics and glass as inorganic materials.",
      section: "04 – Scope of conservation",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q08",
      question: "Why do composite objects require particular consideration during conservation?",
      options: [
        "They are always more valuable than single-material objects.",
        "They cannot be examined scientifically.",
        "They must always receive the same treatment as inorganic materials.",
        "Their different constituent materials may respond differently to environmental conditions and treatment."
      ],
      answer: 3,
      explanation: "Composite objects contain combinations of materials that may respond differently to environmental conditions and treatment.",
      section: "04 – Scope of conservation",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q09",
      question: "A conservator is considering treatment for a deteriorating object. Which consideration would be least appropriate as the sole basis for making that decision?",
      options: [
        "The significance and condition of the object",
        "The possible benefits and risks of intervention",
        "The desire to make the object look visually attractive",
        "The causes and extent of deterioration"
      ],
      answer: 2,
      explanation: "Conservation decisions require consideration of significance, material composition, condition, deterioration, risks, benefits, resources and future care. Visual attractiveness alone is not an adequate basis for treatment.",
      section: "05 – Making conservation decisions",
      difficulty: "Application"
    },
    {
      id: "m01-q10",
      question: "A museum object shows signs of deterioration, but the cause has not been established. What is the most appropriate initial response?",
      options: [
        "Begin treatment immediately to prevent further damage.",
        "Examine the object, investigate the cause and consider possible preventive measures before deciding on treatment.",
        "Replace the deteriorated material with a new material.",
        "Restore the object's original appearance before carrying out documentation."
      ],
      answer: 1,
      explanation: "The lesson emphasises investigation and reasoned decision-making before intervention. The cause of deterioration should be understood, and preventive measures and relevant expertise should be considered.",
      section: "05 and 06 – Decision-making / Think and reflect",
      difficulty: "Application"
    },
    {
      id: "m01-q11",
      question: "Which statement best describes the relationship between conservation and repair?",
      options: [
        "Conservation and repair are exactly the same activity.",
        "Conservation includes a wider range of activities than physical repair alone.",
        "Conservation is only concerned with repairing historic buildings.",
        "Repair is always the first step in every conservation project."
      ],
      answer: 1,
      explanation: "Conservation includes preventive measures, examination, documentation, research, treatment and responsible management. Physical repair is only one possible part of this broader practice.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q12",
      question: "Which group contains only examples of organic materials identified in the lesson?",
      options: [
        "Stone, glass and ceramics",
        "Metals, stone and glass",
        "Paper, textiles, wood and leather",
        "Ceramics, photographs and metals"
      ],
      answer: 2,
      explanation: "Paper, textiles, wood and leather are examples of organic materials discussed in the lesson.",
      section: "04 – Scope of conservation",
      difficulty: "Basic"
    },
    {
      id: "m01-q13",
      question: "Which of the following is an example of built and archaeological heritage?",
      options: [
        "Historic structures, monuments and archaeological sites",
        "Only paintings and sculptures in museums",
        "Only manuscripts and printed books",
        "Modern industrial products without historical associations"
      ],
      answer: 0,
      explanation: "The scope of cultural heritage conservation includes built heritage, monuments and archaeological sites, as well as movable objects and collections.",
      section: "04 – Scope of conservation",
      difficulty: "Basic"
    },
    {
      id: "m01-q14",
      question: "Which statement about preventive conservation is most accurate?",
      options: [
        "It always requires direct physical treatment of an object.",
        "It is relevant only when an object is already severely damaged.",
        "It is concerned only with controlling relative humidity.",
        "It generally addresses the environment and circumstances surrounding objects."
      ],
      answer: 3,
      explanation: "Preventive conservation focuses on the conditions and circumstances surrounding objects and collections in order to avoid or minimise deterioration.",
      section: "03 – Three approaches",
      difficulty: "Basic"
    },
    {
      id: "m01-q15",
      question: "Which combination of factors should inform a conservation decision?",
      options: [
        "The object's appearance and the preferences of the conservator alone",
        "Significance, condition, deterioration, intended use and risks of intervention",
        "The cost of treatment alone",
        "The availability of materials, regardless of their suitability"
      ],
      answer: 1,
      explanation: "Conservation decisions should be reasoned and take account of the object's significance, condition, causes of deterioration, intended use and the potential benefits and risks of intervention.",
      section: "05 – Making conservation decisions",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q16",
      question: "Why is collaboration important in conservation practice?",
      options: [
        "It removes the need for conservators to make professional judgements.",
        "It ensures that every object receives the same treatment.",
        "It brings together different areas of expertise and perspectives.",
        "It makes documentation and examination unnecessary."
      ],
      answer: 2,
      explanation: "Conservation often requires collaboration because objects, collections and their contexts may involve different forms of knowledge and expertise.",
      section: "05 – Making conservation decisions",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q17",
      question: "Which combination of practices is most directly associated with preventive conservation?",
      options: [
        "Retouching losses, filling cracks and reconstructing missing parts",
        "Replacing original materials and restoring an object's appearance",
        "Treating every object regardless of its condition",
        "Reviewing storage, handling and environmental management practices"
      ],
      answer: 3,
      explanation: "Preventive conservation focuses on the conditions and circumstances surrounding objects. Storage, handling and environmental management are therefore central preventive measures.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q18",
      question: "Which statement best describes remedial conservation?",
      options: [
        "It involves direct action to arrest active deterioration or strengthen an object.",
        "It focuses mainly on managing the environment around collections.",
        "It is undertaken only to improve the visual appearance of stable objects.",
        "It involves replacing historic objects with modern replicas."
      ],
      answer: 0,
      explanation: "Remedial conservation involves direct action to arrest active deterioration or strengthen an object when its condition requires such intervention.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q19",
      question: "A stable historic object has been affected by past alteration, which has changed how it is appreciated. Which approach may involve direct action to facilitate its appreciation or understanding?",
      options: [
        "Preventive conservation",
        "Remedial conservation",
        "Restoration",
        "Routine housekeeping"
      ],
      answer: 2,
      explanation: "Restoration is generally undertaken on a stable object when past alteration or deterioration has affected its significance or function, and intervention may facilitate its appreciation, understanding or use.",
      section: "03 – Three approaches",
      difficulty: "Application"
    },
    {
      id: "m01-q20",
      question: "A proposed treatment may improve an object's condition but could also affect its material and future care. What should the conservator do?",
      options: [
        "Proceed because any improvement is beneficial.",
        "Evaluate the object's significance, condition, and the potential benefits and risks before deciding whether to intervene.",
        "Choose the treatment that produces the most visible change.",
        "Avoid documenting the treatment until it is completed."
      ],
      answer: 1,
      explanation: "A conservation decision should be based on careful evaluation. The possible benefits of intervention must be considered alongside risks, material effects and implications for future care.",
      section: "05 – Making conservation decisions",
      difficulty: "Application"
    }
  ];  const root = document.querySelector<HTMLElement>(".module-quiz");

  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-quiz-form]");
    const questionContainer = root.querySelector<HTMLElement>("[data-questions]");
    const progressText = root.querySelector<HTMLElement>("[data-progress-text]");
    const progressBar = root.querySelector<HTMLElement>("[data-progress-bar]");
    const progressTrack = root.querySelector<HTMLElement>("[data-progress-track]");
    const submitButton = root.querySelector<HTMLButtonElement>("[data-submit]");
    const results = root.querySelector<HTMLElement>("[data-results]");

    // Versioned key starts a clean cycle with this revised 20-question bank.
    // It also prevents old attempts from the earlier 10-question version
    // from interfering with the new balanced question selection.
    const storageKey = `waakhal-quiz-${root.dataset.moduleId}-attempted-v2`;

    if (
      form &&
      questionContainer &&
      progressText &&
      progressBar &&
      progressTrack &&
      submitButton &&
      results
    ) {
      const targetCounts: Record<QuizQuestion["difficulty"], number> = {
        Basic: 4,
        Intermediate: 4,
        Application: 2
      };

      const shuffle = <T,>(items: T[]): T[] => {
        const copy = [...items];

        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }

        return copy;
      };

      let attemptedIds: string[] = [];

      try {
        const saved = localStorage.getItem(storageKey);
        const parsed = saved ? JSON.parse(saved) : [];

        if (Array.isArray(parsed)) {
          const validIds = new Set(QUESTION_BANK.map(question => question.id));
          attemptedIds = [...new Set(
            parsed.filter((id): id is string =>
              typeof id === "string" && validIds.has(id)
            )
          )];
        }
      } catch {
        attemptedIds = [];
      }

      const available = QUESTION_BANK.filter(
        question => !attemptedIds.includes(question.id)
      );

      const escapeHtml = (value: string) =>
        value.replace(/[&<>"']/g, char => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        })[char] || char);

      const startFreshCycle = () => {
        try {
          localStorage.removeItem(storageKey);
        } catch {
          // The page can still reload if browser storage is unavailable.
        }

        window.location.reload();
      };

      const continueToNextSet = () => {
        window.location.reload();
      };

      if (available.length === 0) {
        progressText.textContent = "All 20 questions attempted.";
        progressBar.style.width = "100%";
        progressTrack.setAttribute("aria-valuenow", "10");

        questionContainer.innerHTML = `
          <div class="quiz-exhausted">
            <p class="quiz-eyebrow">QUESTION BANK COMPLETED</p>
            <h3>You've completed all 20 questions.</h3>
            <p>
              You have attempted every question in this lesson's question bank.
              Your next attempt will begin a fresh cycle.
            </p>
            <p>
              Questions may appear again, in a new random order.
            </p>
            <button type="button" class="quiz-retake" data-retake>
              Start a fresh cycle <span aria-hidden="true">→</span>
            </button>
          </div>
        `;

        submitButton.hidden = true;

        questionContainer
          .querySelector<HTMLButtonElement>("[data-retake]")
          ?.addEventListener("click", startFreshCycle);
      } else {
        // Select 4 Basic, 4 Intermediate and 2 Application questions.
        // With a fresh 20-question bank, the remaining pool after attempt 1
        // contains exactly the same 4/4/2 distribution for attempt 2.
        const selected: QuizQuestion[] = [];
        const selectedIds = new Set<string>();

        (Object.keys(targetCounts) as QuizQuestion["difficulty"][]).forEach(
          difficulty => {
            const pool = shuffle(
              available.filter(question => question.difficulty === difficulty)
            );

            const chosen = pool.slice(0, targetCounts[difficulty]);

            chosen.forEach(question => {
              selected.push(question);
              selectedIds.add(question.id);
            });
          }
        );

        // Defensive fallback in case stored data is incomplete or altered.
        // Under the normal two-attempt cycle this fallback is not needed.
        if (selected.length < Math.min(10, available.length)) {
          const remainingPool = shuffle(
            available.filter(question => !selectedIds.has(question.id))
          );

          const needed = Math.min(10, available.length) - selected.length;
          selected.push(...remainingPool.slice(0, needed));
        }

        const finalQuestions = shuffle(selected);

        progressText.textContent =
          `0 of ${finalQuestions.length} answered`;

        questionContainer.innerHTML = finalQuestions.map((q, index) => `
          <fieldset class="quiz-question-card">
            <legend class="quiz-question-heading">
              <span class="quiz-question-number">
                QUESTION ${String(index + 1).padStart(2, "0")}
              </span>
              <span class="quiz-difficulty difficulty-${q.difficulty.toLowerCase()}">
                ${q.difficulty}
              </span>
            </legend>

            <p class="quiz-question-text">
              ${escapeHtml(q.question)}
            </p>

            <div class="quiz-options">
              ${q.options.map((option, optionIndex) => `
                <label class="quiz-option">
                  <input
                    type="radio"
                    name="${q.id}"
                    value="${optionIndex}"
                    required
                  >
                  <span class="option-letter">
                    ${String.fromCharCode(65 + optionIndex)}
                  </span>
                  <span class="option-text">
                    ${escapeHtml(option)}
                  </span>
                </label>
              `).join("")}
            </div>
          </fieldset>
        `).join("");

        const updateProgress = () => {
          const answered = finalQuestions.filter(question =>
            form.querySelector<HTMLInputElement>(
              `input[name="${question.id}"]:checked`
            )
          ).length;

          const percentage = (answered / finalQuestions.length) * 100;

          progressText.textContent =
            `${answered} of ${finalQuestions.length} answered`;

          progressBar.style.width = `${percentage}%`;
          progressTrack.setAttribute("aria-valuenow", String(answered));
        };

        questionContainer.addEventListener("change", updateProgress);
        submitButton.disabled = false;

        form.addEventListener("submit", event => {
          event.preventDefault();

          if (submitButton.disabled) return;

          const unanswered = finalQuestions.filter(question =>
            !form.querySelector<HTMLInputElement>(
              `input[name="${question.id}"]:checked`
            )
          );

          if (unanswered.length) {
            const firstUnanswered = form.querySelector<HTMLInputElement>(
              `input[name="${unanswered[0].id}"]`
            );

            firstUnanswered?.focus();

            progressText.textContent =
              `Please answer all ${finalQuestions.length} questions before submitting.`;

            return;
          }

          let score = 0;

          const answerDetails = finalQuestions.map((question, index) => {
            const chosen = form.querySelector<HTMLInputElement>(
              `input[name="${question.id}"]:checked`
            );

            const chosenIndex = chosen ? Number(chosen.value) : -1;
            const correct = chosenIndex === question.answer;

            if (correct) score++;

            return { question, index, chosenIndex, correct };
          });

          // Every submitted question is recorded, including incorrect answers.
          attemptedIds = [
            ...new Set([
              ...attemptedIds,
              ...finalQuestions.map(question => question.id)
            ])
          ];

          try {
            localStorage.setItem(storageKey, JSON.stringify(attemptedIds));
          } catch {
            // Scoring and review still work if browser storage is unavailable.
          }

          const remainingCount = QUESTION_BANK.length - attemptedIds.length;
          const percentage = Math.round(
            (score / finalQuestions.length) * 100
          );

          const feedback = score >= 9
            ? "Excellent understanding."
            : score >= 7
              ? "Good work. Review the explanations to strengthen your understanding."
              : score >= 5
                ? "You're developing your understanding. Revisit the relevant lesson sections."
                : "Consider revisiting the chapter before your next attempt.";

          const nextStepMarkup = remainingCount > 0
            ? `
              <p class="quiz-bank-progress">
                ${attemptedIds.length} of ${QUESTION_BANK.length} questions attempted.
                ${remainingCount} questions remain in the question bank.
              </p>
              <p class="quiz-next-note">
                Your next set will contain the remaining questions.
                Questions from this attempt will not be repeated.
              </p>
              <button type="button" class="quiz-retake" data-next-set>
                Continue to next set <span aria-hidden="true">→</span>
              </button>
            `
            : `
              <p class="quiz-bank-progress">
                You have now attempted all ${QUESTION_BANK.length} questions.
              </p>
              <p class="quiz-next-note">
                You have completed the full question bank. You may now begin
                a fresh cycle; questions may repeat.
              </p>
              <button type="button" class="quiz-retake" data-retake>
                Start a fresh cycle <span aria-hidden="true">→</span>
              </button>
            `;

          results.hidden = false;

          results.innerHTML = `
            <div class="result-summary">
              <p class="quiz-eyebrow">YOUR RESULT</p>

              <div class="result-score">
                <span class="score-number">${score}</span>
                <span class="score-total">/ ${finalQuestions.length}</span>
              </div>

              <p class="result-percentage">${percentage}% correct</p>
              <h3>${feedback}</h3>
              <p class="result-message">
                You answered ${score} of ${finalQuestions.length} questions correctly.
              </p>
            </div>

            <div class="result-review">
              <div class="review-heading">
                <h3>Review your answers</h3>
                <p>Understand the reasoning behind each answer.</p>
              </div>

              ${answerDetails.map(({ question, index, chosenIndex, correct }) => `
                <article class="review-card">
                  <div class="review-card-top">
                    <span class="review-question-number">
                      QUESTION ${String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="review-status ${correct ? "correct" : "incorrect"}">
                      ${correct ? "Correct" : "Incorrect"}
                    </span>
                  </div>

                  <h4>${escapeHtml(question.question)}</h4>

                  <p class="review-answer">
                    <strong>Your answer:</strong>
                    ${escapeHtml(question.options[chosenIndex])}
                  </p>

                  ${correct ? "" : `
                    <p class="review-answer correct-answer">
                      <strong>Correct answer:</strong>
                      ${escapeHtml(question.options[question.answer])}
                    </p>
                  `}

                  <div class="review-explanation">
                    <span>EXPLANATION</span>
                    <p>${escapeHtml(question.explanation)}</p>
                  </div>

                  <p class="review-reference">
                    Lesson reference: ${escapeHtml(question.section)}
                  </p>
                </article>
              `).join("")}
            </div>

            ${nextStepMarkup}
          `;

          form.querySelectorAll<HTMLInputElement>("input").forEach(input => {
            input.disabled = true;
          });

          submitButton.disabled = true;
          submitButton.textContent = "Attempt submitted";

          progressText.textContent = "Attempt completed.";
          progressBar.style.width = "100%";
          progressTrack.setAttribute("aria-valuenow", "10");

          results
            .querySelector<HTMLButtonElement>("[data-next-set]")
            ?.addEventListener("click", continueToNextSet);

          results
            .querySelector<HTMLButtonElement>("[data-retake]")
            ?.addEventListener("click", startFreshCycle);

          results.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        });
      }
    }
  }
</script><style is:global>
  .module-quiz {
    width: 100%;
    padding: 3rem 0 3.5rem;
    margin: 0 0 3rem;
    border-bottom: 1px solid #e8e8e8;
    scroll-margin-top: 2rem;
    color: #292929;
  }

  .module-quiz *,
  .module-quiz *::before,
  .module-quiz *::after {
    box-sizing: border-box;
  }

  .module-quiz .quiz-heading {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .module-quiz .quiz-eyebrow {
    color: #858585;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }

  .module-quiz .quiz-heading h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .module-quiz .quiz-intro {
    max-width: 680px;
    color: #777;
    font-size: 0.98rem;
    line-height: 1.8;
    margin: 0;
  }

  .module-quiz .quiz-progress-area {
    padding: 1.2rem 0 1.5rem;
    margin-bottom: 1.5rem;
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
  }

  .module-quiz .quiz-progress-heading {
    display: flex;
