
---
const moduleId = "conservation-module-01";
---

<section
  id="knowledge-check"
  class="module-quiz"
  data-module-id={moduleId}
  aria-labelledby="quiz-title"
>
  <header class="quiz-heading">
    <p class="quiz-eyebrow">08 / TEST YOUR KNOWLEDGE</p>
    <h2 id="quiz-title">Check your understanding.</h2>
    <p class="quiz-intro">
      Ten questions to help you reflect on what you have learned.
      Read each question carefully and select one answer.
    </p>
  </header>

  <div class="quiz-progress-area">
    <div class="quiz-progress-heading">
      <span class="progress-label">YOUR PROGRESS</span>
      <span data-progress-text>0 of 10 answered</span>
    </div>

    <div
      class="progress-track"
      role="progressbar"
      aria-label="Quiz completion"
      aria-valuemin="0"
      aria-valuemax="10"
      aria-valuenow="0"
      data-progress-track
    >
      <div class="progress-fill" data-progress-bar></div>
    </div>
  </div>

  <form data-quiz-form>
    <div class="quiz-questions" data-questions></div>

    <div class="quiz-footer">
      <p>10 questions · 1 mark each · No negative marking</p>
      <button type="submit" class="quiz-submit" data-submit disabled>
        Submit answers
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </form>

  <div
    class="quiz-results"
    data-results
    hidden
    aria-live="polite"
  ></div>
</section>

<script>
  type QuizQuestion = {
    id: string;
    question: string;
    options: string[];
    answer: number;
    explanation: string;
    section: string;
    difficulty: "Basic" | "Intermediate" | "Application";
  };

  const QUESTION_BANK: QuizQuestion[] = [
    {
      id: "m01-q01",
      question: "What is the primary purpose of cultural heritage conservation?",
      options: [
        "To restore all damaged objects to their original appearance",
        "To safeguard cultural heritage for present and future generations",
        "To make heritage objects suitable for museum display",
        "To replace deteriorated materials with modern alternatives"
      ],
      answer: 1,
      explanation: "Conservation aims to safeguard cultural heritage while ensuring its accessibility to present and future generations.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q02",
      question: "Which of the following best explains why cultural heritage is significant?",
      options: [
        "It provides material evidence of human creativity, knowledge, belief and social experience.",
        "It primarily represents the economic value of historical objects.",
        "It allows museums to display rare and expensive collections.",
        "It provides examples of objects that can be restored."
      ],
      answer: 0,
      explanation: "Cultural heritage carries historical, artistic, scientific, spiritual, social and cultural significance.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q03",
      question: "Which activity is included within the broader practice of conservation?",
      options: [
        "Only repairing physically damaged objects",
        "Only maintaining the appearance of objects",
        "Preventive measures, examination, documentation, research and treatment",
        "Replacing old materials with new materials"
      ],
      answer: 2,
      explanation: "Conservation is broader than repair. It includes preventive measures, scientific examination, documentation, research, treatment and responsible management.",
      section: "02 – What is conservation?",
      difficulty: "Basic"
    },
    {
      id: "m01-q04",
      question: "Which of the following is an example of preventive conservation?",
      options: [
        "Retouching losses in a painting",
        "Reassembling a broken sculpture",
        "Consolidating a fragile painted surface",
        "Improving storage and environmental management"
      ],
      answer: 3,
      explanation: "Preventive conservation aims to avoid or minimise future deterioration through measures addressing the environment and circumstances surrounding objects and collections.",
      section: "03 – Three approaches",
      difficulty: "Basic"
    },
    {
      id: "m01-q05",
      question: "What distinguishes remedial conservation from preventive conservation?",
      options: [
        "Remedial conservation involves direct action to arrest active deterioration or strengthen an object.",
        "Remedial conservation focuses exclusively on improving display conditions.",
        "Remedial conservation is concerned only with historical research.",
        "Remedial conservation involves changing the appearance of stable objects."
      ],
      answer: 0,
      explanation: "Remedial conservation involves direct action when an object's condition is fragile or deteriorating rapidly. Preventive conservation generally addresses the surrounding environment and circumstances.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q06",
      question: "Restoration, as described in the lesson, is generally undertaken on an object that is:",
      options: [
        "Actively deteriorating and structurally unstable",
        "Stable, but affected in its significance or function by past alteration or deterioration",
        "Completely free from any damage",
        "No longer considered culturally significant"
      ],
      answer: 1,
      explanation: "Restoration involves direct action on a stable object to facilitate its appreciation, understanding or use when past alteration or deterioration has affected its significance or function.",
      section: "03 – Three approaches",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q07",
      question: "Which of the following correctly classifies the materials discussed in the lesson?",
      options: [
        "Paper and stone are both organic materials.",
        "Metals and textiles are both organic materials.",
        "Wood and leather are organic materials, while stone and ceramics are inorganic materials.",
        "Glass and photographs are both inorganic materials."
      ],
      answer: 2,
      explanation: "The lesson identifies paper, textiles, wood, leather and photographs as organic materials, and stone, metals, ceramics and glass as inorganic materials.",
      section: "04 – Scope of conservation",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q08",
      question: "Why do composite objects require particular consideration during conservation?",
      options: [
        "They are always more valuable than single-material objects.",
        "They cannot be examined scientifically.",
        "They must always receive the same treatment as inorganic materials.",
        "Their different constituent materials may respond differently to environmental conditions and treatment."
      ],
      answer: 3,
      explanation: "Composite objects contain combinations of materials that may respond differently to environmental conditions and treatment.",
      section: "04 – Scope of conservation",
      difficulty: "Intermediate"
    },
    {
      id: "m01-q09",
      question: "A conservator is considering treatment for a deteriorating object. Which consideration would be least appropriate as the sole basis for making that decision?",
      options: [
        "The significance and condition of the object",
        "The possible benefits and risks of intervention",
        "The desire to make the object look visually attractive",
        "The causes and extent of deterioration"
      ],
      answer: 2,
      explanation: "Conservation decisions require consideration of significance, material composition, condition, deterioration, risks, benefits, resources and future care. Visual attractiveness alone is not an adequate basis for treatment.",
      section: "05 – Making conservation decisions",
      difficulty: "Application"
    },
    {
      id: "m01-q10",
      question: "A museum object shows signs of deterioration, but the cause has not been established. What is the most appropriate initial response?",
      options: [
        "Begin treatment immediately to prevent further damage.",
        "Examine the object, investigate the cause and consider possible preventive measures before deciding on treatment.",
        "Replace the deteriorated material with a new material.",
        "Restore the object's original appearance before carrying out documentation."
      ],
      answer: 1,
      explanation: "The lesson emphasises investigation and reasoned decision-making before intervention. The cause of deterioration should be understood, and preventive measures and relevant expertise should be considered.",
      section: "05 and 06 – Decision-making / Think and reflect",
      difficulty: "Application"
    }
  ];

  const root = document.querySelector<HTMLElement>(
    ".module-quiz[data-module-id]"
  );

  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-quiz-form]");
    const questionContainer = root.querySelector<HTMLElement>("[data-questions]");
    const progressText = root.querySelector<HTMLElement>("[data-progress-text]");
    const progressBar = root.querySelector<HTMLElement>("[data-progress-bar]");
    const progressTrack = root.querySelector<HTMLElement>("[data-progress-track]");
    const submitButton = root.querySelector<HTMLButtonElement>("[data-submit]");
    const results = root.querySelector<HTMLElement>("[data-results]");

    const storageKey = `waakhal-quiz-${root.dataset.moduleId}-attempted`;

    if (
      form &&
      questionContainer &&
      progressText &&
      progressBar &&
      progressTrack &&
      submitButton &&
      results
    ) {
      let attemptedIds: string[] = [];

      try {
        const saved = localStorage.getItem(storageKey);
        const parsed = saved ? JSON.parse(saved) : [];
        attemptedIds = Array.isArray(parsed) ? parsed : [];
      } catch {
        attemptedIds = [];
      }

      const available = QUESTION_BANK.filter(
        question => !attemptedIds.includes(question.id)
      );

      // Randomise the available questions.
      const shuffled = [...available];

      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }

      const selected = shuffled.slice(0, 10);

      const escapeHtml = (value: string) =>
        value.replace(/[&<>"']/g, char => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        })[char] || char);

      if (selected.length === 0) {
        progressText.textContent = "Question bank completed.";
        progressBar.style.width = "100%";
        progressTrack.setAttribute("aria-valuenow", "10");

        questionContainer.innerHTML = `
          <div class="quiz-exhausted">
            <p class="quiz-eyebrow">COMPLETED</p>
            <h3>You've reached the end of this question bank.</h3>
            <p>
              You have attempted all ${QUESTION_BANK.length} questions
              currently available for this lesson. New questions will
              be added in a future update.
            </p>
          </div>
        `;

        submitButton.hidden = true;
        progressText.textContent = "All available questions attempted.";
      } else {
        progressText.textContent = `0 of ${selected.length} answered`;

        questionContainer.innerHTML = selected.map((q, index) => `
          <fieldset class="quiz-question-card">
            <legend class="quiz-question-heading">
              <span class="quiz-question-number">
                QUESTION ${String(index + 1).padStart(2, "0")}
              </span>
              <span class="quiz-difficulty difficulty-${q.difficulty.toLowerCase()}">
                ${q.difficulty}
              </span>
            </legend>

            <p class="quiz-question-text">
              ${escapeHtml(q.question)}
            </p>

            <div class="quiz-options">
              ${q.options.map((option, optionIndex) => `
                <label class="quiz-option">
                  <input
                    type="radio"
                    name="${q.id}"
                    value="${optionIndex}"
                    required
                  >
                  <span class="option-letter">
                    ${String.fromCharCode(65 + optionIndex)}
                  </span>
                  <span class="option-text">
                    ${escapeHtml(option)}
                  </span>
                </label>
              `).join("")}
            </div>
          </fieldset>
        `).join("");

        const updateProgress = () => {
          const answered = selected.filter(q =>
            form.querySelector<HTMLInputElement>(
              `input[name="${q.id}"]:checked`
            )
          ).length;

          const percentage = (answered / selected.length) * 100;

          progressText.textContent =
            `${answered} of ${selected.length} answered`;

          progressBar.style.width = `${percentage}%`;
          progressTrack.setAttribute("aria-valuenow", String(answered));
        };

        questionContainer.addEventListener("change", updateProgress);
        submitButton.disabled = false;
      }

      form.addEventListener("submit", event => {
        event.preventDefault();

        if (!selected.length || submitButton.disabled) return;

        const unanswered = selected.filter(q =>
          !form.querySelector<HTMLInputElement>(
            `input[name="${q.id}"]:checked`
          )
        );

        if (unanswered.length) {
          const first = form.querySelector<HTMLInputElement>(
            `input[name="${unanswered[0].id}"]`
          );

          first?.focus();

          progressText.textContent =
            `Please answer all ${selected.length} questions before submitting.`;

          return;
        }

        let score = 0;

        const answerDetails = selected.map((q, index) => {
          const chosen = form.querySelector<HTMLInputElement>(
            `input[name="${q.id}"]:checked`
          );

          const chosenIndex = chosen ? Number(chosen.value) : -1;
          const correct = chosenIndex === q.answer;

          if (correct) score++;

          return { q, index, chosenIndex, correct };
        });

        // Record all attempted questions, including incorrect answers.
        attemptedIds = [
          ...new Set([...attemptedIds, ...selected.map(q => q.id)])
        ];

        try {
          localStorage.setItem(storageKey, JSON.stringify(attemptedIds));
        } catch {
          // Quiz remains usable if browser storage is unavailable.
        }

        const percentage = Math.round((score / selected.length) * 100);

        const feedback = score >= 9
          ? "Excellent understanding."
          : score >= 7
            ? "Good work. Review the explanations to strengthen your understanding."
            : score >= 5
              ? "You're developing your understanding. Revisit the relevant lesson sections."
              : "Consider revisiting the chapter before your next attempt.";

        results.hidden = false;

        results.innerHTML = `
          <div class="result-summary">
            <p class="quiz-eyebrow">YOUR RESULT</p>

            <div class="result-score">
              <span class="score-number">${score}</span>
              <span class="score-total">/ ${selected.length}</span>
            </div>

            <p class="result-percentage">${percentage}% correct</p>
            <h3>${feedback}</h3>
            <p class="result-message">
              You answered ${score} of ${selected.length} questions correctly.
            </p>
          </div>

          <div class="result-review">
            <div class="review-heading">
              <h3>Review your answers</h3>
              <p>Understand the reasoning behind each answer.</p>
            </div>

            ${answerDetails.map(({ q, index, chosenIndex, correct }) => `
              <article class="review-card">
                <div class="review-card-top">
                  <span class="review-question-number">
                    QUESTION ${String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="review-status ${correct ? "correct" : "incorrect"}">
                    ${correct ? "Correct" : "Incorrect"}
                  </span>
                </div>

                <h4>${escapeHtml(q.question)}</h4>

                <p class="review-answer">
                  <strong>Your answer:</strong>
                  ${escapeHtml(q.options[chosenIndex])}
                </p>

                ${correct ? "" : `
                  <p class="review-answer correct-answer">
                    <strong>Correct answer:</strong>
                    ${escapeHtml(q.options[q.answer])}
                  </p>
                `}

                <div class="review-explanation">
                  <span>EXPLANATION</span>
                  <p>${escapeHtml(q.explanation)}</p>
                </div>

                <p class="review-reference">
                  Lesson reference: ${escapeHtml(q.section)}
                </p>
              </article>
            `).join("")}
          </div>

          <p class="quiz-bank-progress">
            ${attemptedIds.length} of ${QUESTION_BANK.length}
            available questions attempted.
          </p>
        `;

        form.querySelectorAll<HTMLInputElement>("input").forEach(input => {
          input.disabled = true;
        });

        submitButton.disabled = true;
        submitButton.textContent = "Attempt submitted";

        progressText.textContent = "Attempt completed.";
        progressBar.style.width = "100%";
        progressTrack.setAttribute("aria-valuenow", "10");

        results.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });
    }
  }
</script>

<style is:global>
  .module-quiz {
    width: 100%;
    padding: 3rem 0 3.5rem;
    margin: 0 0 3rem;
    border-bottom: 1px solid #e8e8e8;
    scroll-margin-top: 2rem;
    color: #292929;
  }

  .module-quiz *,
  .module-quiz *::before,
  .module-quiz *::after {
    box-sizing: border-box;
  }

  .module-quiz .quiz-heading {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .module-quiz .quiz-eyebrow {
    color: #858585;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }

  .module-quiz .quiz-heading h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .module-quiz .quiz-intro {
    max-width: 680px;
    color: #777;
    font-size: 0.98rem;
    line-height: 1.8;
    margin: 0;
  }

  .module-quiz .quiz-progress-area {
    padding: 1.2rem 0 1.5rem;
    margin-bottom: 1.5rem;
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
  }

  .module-quiz .quiz-progress-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: #777;
    font-size: 0.85rem;
  }

  .module-quiz .progress-label {
    color: #858585;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .module-quiz .progress-track {
    width: 100%;
    height: 5px;
    overflow: hidden;
    border-radius: 20px;
    background: #eeeeeb;
  }

  .module-quiz .progress-fill {
    width: 0;
    height: 100%;
    border-radius: 20px;
    background: #718875;
    transition: width 0.25s ease;
  }

  .module-quiz .quiz-questions {
    display: grid;
    gap: 1.2rem;
  }

  .module-quiz .quiz-question-card {
    display: block;
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid #e8e8e8;
    border-radius: 7px;
    background: #fff;
  }

  .module-quiz .quiz-question-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0;
    margin: 0 0 1rem;
    border: 0;
  }

  .module-quiz .quiz-question-number {
    color: #858585;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .module-quiz .quiz-difficulty {
    padding: 0.3rem 0.55rem;
    border-radius: 3px;
    background: #f3f4f1;
    color: #687568;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .module-quiz .difficulty-application {
    background: #f5f1e9;
    color: #927648;
  }

  .module-quiz .quiz-question-text {
    color: #292929;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.65;
    margin: 0 0 1.2rem;
  }

  .module-quiz .quiz-options {
    display: grid;
    gap: 0.65rem;
  }

  .module-quiz .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid #e9e9e7;
    border-radius: 5px;
    background: #fff;
    color: #666;
    font-size: 0.9rem;
    line-height: 1.65;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .module-quiz .quiz-option:hover {
    border-color: #a5b2a1;
    background: #fafbf9;
  }

  .module-quiz .quiz-option:has(input:checked) {
    border-color: #718875;
    background: #f5f7f4;
    color: #303830;
  }

  .module-quiz .quiz-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .module-quiz .quiz-option:has(input:focus-visible) {
    outline: 2px solid #718875;
    outline-offset: 3px;
  }

  .module-quiz .option-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 25px;
    width: 25px;
    height: 25px;
    border: 1px solid #dededb;
    border-radius: 50%;
    color: #777;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
  }

  .module-quiz .quiz-option:has(input:checked) .option-letter {
    border-color: #718875;
    background: #718875;
    color: #fff;
  }

  .module-quiz .option-text {
    flex: 1;
  }

  .module-quiz .quiz-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.8rem;
  }

  .module-quiz .quiz-footer p {
    color: #888;
    font-size: 0.8rem;
    line-height: 1.6;
    margin: 0;
  }

  .module-quiz .quiz-submit {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem;
    border: 0;
    border-radius: 4px;
    background: #647b69;
    color: #fff;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .module-quiz .quiz-submit:hover:not(:disabled) {
    background: #506554;
  }

  .module-quiz .quiz-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .module-quiz .quiz-results {
    margin-top: 2.5rem;
    scroll-margin-top: 2rem;
  }

  .module-quiz .result-summary {
    padding: 2rem;
    border: 1px solid #e8e8e8;
    border-radius: 7px;
    background: #f8f9f7;
  }

  .module-quiz .result-score {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0.5rem 0;
  }

  .module-quiz .score-number {
    color: #303830;
    font-size: 4rem;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .module-quiz .score-total {
    color: #858585;
    font-size: 1.4rem;
  }

  .module-quiz .result-percentage {
    color: #647b69;
    font-size: 1rem;
    font-weight: 600;
  }

  .module-quiz .result-summary h3 {
    margin: 1.2rem 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .module-quiz .result-message {
    margin: 0;
    color: #777;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .module-quiz .result-review {
    margin-top: 2.5rem;
  }

  .module-quiz .review-heading {
    margin-bottom: 1.2rem;
  }

  .module-quiz .review-heading h3 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .module-quiz .review-heading p {
    margin: 0;
    color: #858585;
    font-size: 0.88rem;
  }

  .module-quiz .review-card {
    padding: 1.4rem 0;
    border-top: 1px solid #e8e8e8;
  }

  .module-quiz .review-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .module-quiz .review-question-number {
    color: #858585;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .module-quiz .review-status {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .module-quiz .review-status.correct {
    color: #547b5b;
  }

  .module-quiz .review-status.incorrect {
    color: #a45a4f;
  }

  .module-quiz .review-card h4 {
    margin: 0 0 0.9rem;
    color: #292929;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .module-quiz .review-answer {
    margin: 0.5rem 0;
    color: #707070;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .module-quiz .correct-answer {
    color: #547b5b;
  }

  .module-quiz .review-explanation {
    padding: 1rem;
    margin-top: 1rem;
    border-left: 3px solid #9aaa94;
    background: #f7f8f6;
